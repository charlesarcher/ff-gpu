tests/m4_kernel_unit_bin
tests/m4_order_bin
tests/slab_cmp
src/m0_benchmark.o
*.o

# Scratch outputs regenerated by the test harnesses (m4_order.cpp writes these)
gpu_search_output_65536.txt
ref_ff_seg_65536.txt

# Orchestrator state (never commit)
.omo/
