# Scratch / per-leg run dirs (golden regeneration + verify.sh capture)
run/

# Reference programs chdir into ffPlayground in their cwd and leave
# ffpartNNN partial files behind on failure — never commit either.
ffPlayground/
ffpart*

# verify.sh writes the GPU binary's captured-and-normalized stdout here
out.txt

# Reference binaries are build artifacts (built by cmake --preset dev)
reference/ff_seg
reference/ff_seg2
reference/pen
reference/pen2

# Build tree (cmake --preset dev)
build/

# Test binaries and object files (CMake artifacts, never commit)
test/source/m4_kernel_unit_bin
test/source/m4_order_bin
test/source/slab_cmp
source/m0_benchmark.o
*.o

# Scratch outputs regenerated by the test harnesses (m4_order.cpp writes these)
gpu_search_output_65536.txt
ref_ff_seg_65536.txt

# Orchestrator state (never commit)
.omo/
