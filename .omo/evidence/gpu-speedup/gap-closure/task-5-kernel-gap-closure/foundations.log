## New API (source/geometry.{h,cpp})
  inline constexpr uint64_t kWheelModulus = 30;                  // 2*3*5
  inline constexpr unsigned kWheelResidueCount = 8;
  inline constexpr uint8_t  kWheelResidues[8] = {1,7,11,13,17,19,23,29}; // bit i <-> 30k+res[i]
  uint64_t canonicalMapBytes(uint64_t span);   // ceil(span/16) — --dump-map/hostMap sizing (unchanged chain)
  uint64_t internalMapBytes(uint64_t span);    // ceil(span/30) — plan's bufMin, honest 1.875x vs canonical
  void expandWheel30ToCanonical(const uint8_t* src, uint8_t* dst, uint64_t span);
  void compactCanonicalToWheel30(const uint8_t* src, uint8_t* dst, uint64_t span);
  LegGeometry gains: uint64_t internalMapBytes (= internalMapBytes(mapBytes<<4));
  mapBytes/maxPrimeMapValue numeric semantics UNCHANGED.
Expand semantics: dst fully defined — coprime-residue bits copied from src; odd multiples
of 3/5 set iff v==3||v==5; padding cleared. compact = inverse (never reads 3/5-multiple bits).
Round-trip: compact(expand(x))==x for zero-padding x; expand(compact(y))==y for residue-valid y.

